#!/usr/bin/env bash
set -euo pipefail

# phonotype-ydotoold: starts the system ydotoold with a per-user socket.

SOCKET_PATH="${HOME}/.ydotool_socket"
OWNER_UID="$(id -u)"
OWNER_GID="$(id -g)"

have_cmd() { command -v "$1" >/dev/null 2>&1; }

resolve_ydotoold() {
  if have_cmd ydotoold; then
    command -v ydotoold
    return 0
  fi
  echo "ydotoold is not installed (Gentoo: emerge x11-misc/ydotool)" >&2
  return 1
}

YDBIN="$(resolve_ydotoold)" || {
  echo "phonotype-ydotoold: cannot resolve ydotoold" >&2
  exit 1
}

# Exec daemon with desired socket path and ownership
exec "$YDBIN" --socket-path="$SOCKET_PATH" --socket-own="$OWNER_UID:$OWNER_GID"

